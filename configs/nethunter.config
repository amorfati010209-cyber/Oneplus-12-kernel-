# Базовые настройки NetHunter для ядра Android 16 (GKI 6.1)

# USB Gadget & HID
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_HID=y
CONFIG_USB_F_HID=y

# Networking & Wi-Fi Injection Support
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y

# Drivers for external Wi-Fi adapters (examples)
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_WLAN_VENDOR_RALINK=y

# Bluetooth support
CONFIG_BT=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_HCIBTUSB=y
